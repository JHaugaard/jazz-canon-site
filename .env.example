# Copy to .env.local and fill in values. Never commit .env.local.

# Database — read-only role for export script
# Role: _jazzcanon_ro (SELECT only on _jazzcanon schema)
# Connects via localhost on vps8. For Tailscale remote access, swap hostname.
JAZZCANON_DB_URL=postgresql://_jazzcanon_ro:<password>@localhost:5433/postgres

# Apple Music / MusicKit (Phase 5E — front-end integration)
# Developer token is a JWT (ES256) signed from your .p8 key, max 180-day exp.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us
